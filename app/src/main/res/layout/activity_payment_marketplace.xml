<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/buttonIconBackground">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/accentColor"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margin_standard"
        android:paddingEnd="@dimen/margin_standard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_to_marketplace"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/left"
            app:tint="#fff" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/googlesans_medium"
            android:gravity="start"
            android:text="Checkout"
            android:textColor="#fff"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Main Payment Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/btnAddAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="16dp"
                android:background="@color/white"
                android:orientation="horizontal">

                <!-- TextView untuk memilih metode pembayaran -->
                <TextView
                    android:id="@+id/txtalamat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesans_medium"
                    android:text="Masukan Alamat terlebih dahulu"
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/addressView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:layout_margin="5dp"
                    android:visibility="gone"
                    android:background="@drawable/rounded_backgroundcard"
                    android:elevation="2dp"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:lineSpacingExtra="8dp"
                    android:gravity="start|top"
                    android:text="Nama: John Doe\nAlamat: Jl. Sudirman No. 5, Jakarta\nKota: Jakarta\nKecamatan: Tanah Abang"
                    android:fontFamily="@font/googlesans_medium"
                    android:maxLines="5"
                    android:scrollHorizontally="false" />

                <!-- Dropdown Icon -->
                <ImageView
                    android:id="@+id/icarrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/baseline_arrow_forward_ios"
                    android:contentDescription="Dropdown Arrow"/>
            </LinearLayout>
=            <!-- RecyclerView untuk menampilkan daftar produk -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/paymentRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:layout_marginTop="7dp"
                android:padding="16dp"/>
            <!-- Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:background="@color/white"
                android:orientation="horizontal">

                <!-- TextView untuk memilih metode pembayaran -->
                <TextView
                    android:id="@+id/textview1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/googlesans_medium"
                    android:text="Pilih Metode Pembayaran"
                    android:textColor="@color/black"

                    android:textSize="16sp"
                    android:layout_weight="1"
                    android:textStyle="bold"/>

                <!-- Dropdown Icon -->
                <ImageView
                    android:id="@+id/icon_arrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrowdown"
                    android:contentDescription="Dropdown Arrow"/>
            </LinearLayout>

            <!-- Radio Group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:padding="16dp"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/radioGroupPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textview1">

                    <!-- DANA Option -->
                    <RadioButton
                        android:id="@+id/rb_dana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/icondana1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="DANA"
                        android:textColor="@color/black" />

                    <!-- GoPay Option -->
                    <RadioButton
                        android:id="@+id/rb_gopay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/icongopay1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="GoPay"
                        android:textColor="@color/black" />

                    <!-- OVO Option -->
                    <RadioButton
                        android:id="@+id/rb_ovo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/iconovo1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="OVO"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <!-- QRIS Option -->
                    <RadioButton
                        android:id="@+id/rb_qris"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/iconqris1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Scan Via QRIS"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <!-- Transfer Bank BRI Option -->
                    <RadioButton
                        android:id="@+id/rb_bri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/iconbri1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Transfer Bank BRI"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <!-- Transfer Bank BCA Option -->
                    <RadioButton
                        android:id="@+id/rb_bca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/iconbca1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Transfer Bank BCA"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <!-- Transfer Bank Mandiri Option -->
                    <RadioButton
                        android:id="@+id/rb_mandiri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/iconmandiri1"
                        android:drawablePadding="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Transfer Bank Mandiri"
                        android:textColor="@color/black"
                        android:visibility="gone" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutestimasi"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="7dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/texbebas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/googlesans_medium"
                            android:text="Bebas"
                            android:textColor="@color/accentColor"
                            android:textSize="14dp" />

                        <TextView
                            android:id="@+id/texongkir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/googlesans_medium"
                            android:text="Ongkir"
                            android:textColor="@color/accentColor"
                            android:textSize="14dp" />


                    </LinearLayout>

                    <TextView
                        android:id="@+id/texhargaestimasi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/googlesans_medium"
                        android:text="Rp0"
                        android:textColor="@color/black"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/texhargaestimasidiskon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/googlesans_medium"
                        android:text="Rp13.000"
                        android:textColor="@color/secondaryTextColor"
                        android:textSize="14dp" />

                    <ImageView
                        android:id="@+id/imageViewRinci"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/baseline_arrow_forward_ios"
                        app:tint="@color/accentColor" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/productDescriptionestimasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="4dp"
                        android:fontFamily="@font/googlesans_regular"
                        android:justificationMode="inter_word"
                        android:text="Bisa COD"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14dp" />

                    <TextView
                        android:id="@+id/titik"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="7dp"
                        android:fontFamily="@font/googlesans_regular"
                        android:text="."
                        android:textColor="@color/black"
                        android:textSize="26dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/product"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/googlesans_regular"
                        android:justificationMode="inter_word"
                        android:text="Estimasi Tiba 30 Dec - 1 Jan"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Total Price -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cartBottomLayout"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="7dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">



                <!-- Informasi Ongkir dan Harga Produk -->
                <LinearLayout
                    android:id="@+id/linearLayoutInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@color/white"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <!-- Harga Produk -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/textViewOngkir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/googlesans_regular"
                            android:text="Ongkir"
                            android:textColor="@color/black" />


                        <TextView
                            android:id="@+id/shippingCostView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_gravity="end"
                            android:text="Rp 0"
                            android:textColor="@color/black" />
                    </LinearLayout>

                    <!-- Ongkir -->
                    <LinearLayout
                        android:id="@+id/linearLayoutOngkir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/googlesans_regular"
                            android:text="Harga produk"
                            android:layout_weight="1"
                            android:textColor="@color/black" />

                        <TextView
                            android:id="@+id/totalPriceView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_gravity="end"
                            android:text="Rp 0"
                            android:textColor="@color/black" />
                    </LinearLayout>
                </LinearLayout>
                <!-- Garis Pemisah -->
                <View
                    android:id="@+id/view2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:background="@color/lightGray"
                    app:layout_constraintBottom_toTopOf="@+id/linearLayoutTotal"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayoutInfo" />
                <!-- Total -->
                <LinearLayout
                    android:id="@+id/linearLayoutTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/btnProceedPayment"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayoutInfo">

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/googlesans_medium"
                        android:text="Total"
                        android:textColor="@color/black"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/finalPriceView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="16dp"
                        android:text="Rp 0"
                        android:textColor="@color/black"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Tombol Checkout -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnProceedPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Konfirmasi Pembayaran"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="@color/buttonColor"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/googlesans_medium"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="14dp"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
