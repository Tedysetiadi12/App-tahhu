<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <RadioGroup
        android:id="@+id/radioGroupReasons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioScheduleConflict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jadwal bertabrakan dengan kegiatan lain" />

        <RadioButton
            android:id="@+id/radioLocationIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi terlalu jauh" />

        <RadioButton
            android:id="@+id/radioPersonalIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ada keperluan mendadak" />

        <RadioButton
            android:id="@+id/radioOtherReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alasan lainnya" />
    </RadioGroup>

</LinearLayout>