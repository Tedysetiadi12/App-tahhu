<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/rounded_background_banner"
    android:gravity="center"
    android:layout_gravity="center">

    <ImageView
        android:layout_width="164dp"
        android:layout_height="164dp"
        android:src="@drawable/emoji_heart_eyes"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Driver Has Arrived!"
        android:textSize="20sp"
        android:fontFamily="@font/googlesans_regular"
        android:textStyle="bold"
        android:textColor="@color/accentColor"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enjoy your meal!\nSee you in the next order :)"
        android:textAlignment="center"
        android:textSize="16sp"
        android:fontFamily="@font/googlesans_regular"
        android:textColor="#666666"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="OK"
        app:cornerRadius="25dp"
        android:textSize="@dimen/margin_standard"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/buttonColor"
        android:padding="12dp"/>

</LinearLayout>