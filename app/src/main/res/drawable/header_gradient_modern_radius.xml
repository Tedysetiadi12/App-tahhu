<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Transparent Background -->
    <item android:left="0dp" android:right="0dp">
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Base Gradient -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FF7043"
                android:centerColor="#FF8F00"
                android:endColor="#FF5722"
                android:centerX="0.7"
                android:centerY="0.7" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>

    <!-- Subtle Overlay -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="250%p"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerX="0.9"
                android:centerY="0.9" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
